# 법제처 오픈API 인증키 (필수)
# 발급: https://www.law.go.kr/DRF/lawService.do
LAW_OC=your-api-key-here

# 법제처 API 호출 프로토콜 (기본값: https)
# 폐쇄망/인증서 문제가 있는 환경에서는 http 사용
LAW_API_PROTOCOL=https

# 찾기 쉬운 생활법령정보 Open API 서비스키 (선택)
# 발급: https://open.easylaw.go.kr (OpenAPI 신청). 없으면 search_life_law 는 법제처 공개 생활법령 MCP 로 대신하고
# get_life_law·region·lang 은 쓸 수 없다. 외부 호출은 키에 등록한 도메인만 받으므로 그 도메인을 EASYLAW_REFERER 로 준다
# EASYLAW_SERVICE_KEY=
# EASYLAW_REFERER=https://example.org/

# 외부 정보제공 서버 HTTPS 프록시 (선택)
# 현재는 국세청 판례 본문 fallback(taxlaw.nts.go.kr)에 적용
# LAW_EXTERNAL_HTTPS_PROXY=http://proxy-host:8080

# 외부 HTTPS 프록시 경로에서만 TLS 검증 비활성화 (진단/임시 우회용)
# 운영 상시 설정으로 사용하지 마세요
# LAW_EXTERNAL_TLS_REJECT_UNAUTHORIZED=0
